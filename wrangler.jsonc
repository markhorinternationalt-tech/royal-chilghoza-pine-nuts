{
  "name": "royal-chilghoza-pine-nuts",
  "main": "worker.js",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/trade",
      "/trade/*",
      "/research",
      "/research/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "ROYAL_KV",
      "id": "74317e4d2e174dee813653e8878fed6d"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
