{
  "name": "royal-chilghoza-pine-nuts",
  "main": "worker.js",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/trade/*", "/research/*", "/sitemap.xml"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "ROYAL_KV",
      "id": "74317e4d2e174dee813653e8878fed6d"
    }
  ],
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "agnhxdu4",
    "CLOUDINARY_API_KEY": "118953582795868"
  }
}
